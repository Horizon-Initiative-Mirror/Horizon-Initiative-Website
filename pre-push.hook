#!/bin/bash
dialog --yesno "Do you wish to push changes to NeoCities (This may take a long time, see README.txt or https://horizon-initiative.neocities.org/assets/html/contrib.html for more information)" 0 0 2>$TEMP
CHOICE=`cat $TEMP`
case $CHOICE in
    0)
    neocities push --prune ./site
    ;;
    1)
    echo "Skipping Neocities push!"
    ;;
    *)
    exit 1
esac
