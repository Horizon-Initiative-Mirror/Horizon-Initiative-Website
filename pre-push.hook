#!/bin/bash
TEMP=2
dialog --yesno "Did you build the site before pushing?" 0 0 && echo "Good" || exit 1
dialog --yesno "Do you wish to push changes to NeoCities (This may take a long time)" 0 0
EXIT_CODE=$?
clear
case $EXIT_CODE in
    0)
    neocities push --prune ./site || echo "An error occurred while pushing to NeoCities!"
    #echo "Press any key to continue..."
 
    # -s: Do not echo input coming from a terminal
    # -n 1: Read one character
    #read -s -n 1
    #clear
    ;;
    1)
    dialog --infobox "Skipping Neocities push!" 0 0
    ;;
    *)
    echo "An internal error has occurred in the pre-push hook!"
    exit 1
esac
